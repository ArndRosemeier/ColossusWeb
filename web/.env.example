# Online play runs on GameHub (https://games.futuremagic.de), see src/net/hubConfig.ts.
# Copy to .env.local (gitignored) or set these in the build environment.
# The app key is NOT a secret: it ships in the bundle and only names the game.
VITE_GAMEHUB_URL=https://games.futuremagic.de
VITE_GAMEHUB_APP=colossusweb
VITE_GAMEHUB_KEY=ghk_colossusweb_...
